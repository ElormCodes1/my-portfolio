# Blog posts live in content/blog/*.md (no CMS env required)

# PostgreSQL (Lab explorer) — use ONE of these approaches:

# Option A: individual vars (quote passwords with $ or @ using single quotes in .env)
PGHOST=127.0.0.1
PGUSER=postgres
PGPASSWORD='your-password-here'
PGDATABASE=webscraping_business_data
PGPORT=5432
# PGSSLMODE=require

# Option B: connection string
# DATABASE_URL=postgresql://postgres:password@host:5432/webscraping_business_data

# Contact form / sheets (server-only)
# MAIL_USERNAME=
# OTHER_MAIL_PASSWORD=
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_SHEET_ID=
